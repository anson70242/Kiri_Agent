{
  "model": "${OPENAI_MODEL}",
  "base_url": "${OPENAI_BASE_URL}",
  "api_key_env": "OPENAI_API_KEY",
  "max_tokens": 4096,
  "temperature": 0.7,
  "max_steps": 40,
  "request_timeout": 600,
  "default_agent": "main",
  "agents": {
    "main": {
      "prompt": "main.md",
      "tools": "*"
    }
  },
  "monitor": {
    "interval": 60,
    "streamers": [
      { "name": "惑世いと", "platform": "youtube", "channel": "@wakuse_ito" },
      { "name": "柊優花", "platform": "youtube", "channel": "@柊優花", "auto_download": true },
      { "name": "東雲はる", "platform": "youtube", "channel": "@東雲はるch", "auto_download": true },
      { "name": "sola", "platform": "youtube", "channel": "@sola_she" },
      { "name": "鹿乃まほろ", "platform": "youtube", "channel": "@Kano_", "auto_download": true },
      { "name": "柊優花", "platform": "twitch", "channel": "hiiragiyukaofficial", "auto_download": true }
    ]
  },
  "notify": {
    "on_startup": false,
    "on_offline": true,
    "offline_grace": 120,
    "discord": { "webhook_env": "DISCORD_WEBHOOK_URL", "mention": "" }
  },
  "llm": {
    "base_url": "http://127.0.0.1:8317/v1",
    "api_key_env": "AGY_API_KEY",
    "model": "gemini-3-flash",
    "proxy": true
  },
  "analysis": { "segment_minutes": 5, "context_seconds": 30, "min_score": 7 },
  "translate": { "group": 80, "context": 5 },
  "asr": { "url": "http://whisper:8000", "language": "ja", "vad": true },
  "upload": {
    "tencent": { "token_env": "TENCENT_DOCS_MCP_TOKEN" }
  },
  "download": {
    "output_dir": "downloads",
    "cookies_file": "data/youtube_cookies.txt",
    "cookies_from_browser": "firefox",
    "twitch_oauth_env": "TWITCH_OAUTH",
    "ffmpeg": "",
    "max_height": 1080,
    "chat_retry": { "interval_minutes": 30, "give_up_hours": 48 },
    "auto": { "keep": 6, "retry_minutes": 15, "give_up_hours": 12, "max_errors": 3 }
  }
}