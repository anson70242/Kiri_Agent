# Copy to .env and fill in. .env is gitignored; this file is not.
# config.json refers to these by name, so switching provider is an edit here.

# OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# A local OpenAI-compatible server (llama.cpp, vLLM, Ollama, LM Studio, ...)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=your-key

# Discord go-live notifications: channel settings → Integrations → Webhooks → Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# QQ group notifications: an official QQ bot (q.qq.com → your bot → 开发设置: AppID /
# AppSecret, events by WebSocket). Groups appear on the 通知 page once the bot is added
# to a group or @-mentioned there. Without these, QQ is off.
# QQ_BOT_APP_ID=...
# QQ_BOT_SECRET=...

# Downloader: Twitch subscriber-only VODs. Value of the `auth-token` cookie on twitch.tv
# (browser devtools → Application → Cookies → https://www.twitch.tv).
# TWITCH_OAUTH=...

# Analysis LLM (config.json "llm": base_url, model, api_key_env, proxy on/off).
# Here: Google agy through CLIProxyAPI on the Japan PC (127.0.0.1:8317 there).
# AGY_API_KEY=sk-...

# LLM proxy (OpenAI / Anthropic / Gemini don't serve Hong Kong). On the machine in Japan
# that runs `uv run -m backend.llm_proxy`: a random password, 16+ chars.
# LLM_PROXY_TOKEN=...
# On the server: route only LLM calls through that machine (its Tailscale IP); used
# when config.json "llm.proxy" is true. Optional on the Japan machine:
# LLM_PROXY_HTTP_ALLOW=127.0.0.1:8317   (local plain-HTTP LLM gateways it may forward to)
# LLM_PROXY=http://kiri:<LLM_PROXY_TOKEN>@100.126.34.25:8118

# Tencent Docs upload of the 路灯表 (shared by every streamer; which spreadsheet each one
# uploads to is set in the dashboard's ⚙ gear). Without it, uploading is skipped.
# A personal MCP token: scan the QR code at https://docs.qq.com/open/auth/mcp.html with
# the QQ / WeChat account that owns (or can edit) the spreadsheets. When it expires, every
# upload fails with "rejected the token": get a new one, then on the server
# `docker compose up -d --force-recreate kiri` (a plain restart doesn't re-read .env).
# TENCENT_DOCS_MCP_TOKEN=...
